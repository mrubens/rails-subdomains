<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Subdomains 💕 Valentine's Edition" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rails Subdomains Valentine's Edition">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <!-- Corner hearts with different animations -->
    <div class="corner-heart-tl">💖</div>
    <div class="corner-heart-tr">💕</div>
    <div class="corner-heart-bl">💗</div>
    <div class="corner-heart-br">💝</div>
    
    <!-- Mid-screen side hearts -->
    <div class="mid-heart-left">💓</div>
    <div class="mid-heart-right">❤️</div>
    
    <!-- Top garland of hearts -->
    <div class="top-garland">
      <span>💖</span>
      <span>💕</span>
      <span>💗</span>
      <span>💝</span>
      <span>💓</span>
      <span>❤️</span>
      <span>💖</span>
    </div>
    
    <!-- Bottom garland of hearts -->
    <div class="bottom-garland">
      <span>💕</span>
      <span>💖</span>
      <span>💗</span>
      <span>💝</span>
      <span>💓</span>
      <span>❤️</span>
      <span>💕</span>
    </div>
    
    <!-- Side vertical heart chains -->
    <div class="side-hearts-left">
      <span>💕</span>
      <span>💖</span>
      <span>💗</span>
      <span>💝</span>
      <span>💓</span>
    </div>
    
    <div class="side-hearts-right">
      <span>❤️</span>
      <span>💕</span>
      <span>💖</span>
      <span>💗</span>
      <span>💝</span>
    </div>
    
    <!-- Central pulsing heart -->
    <div class="center-pulse-hearts">💖</div>
    
    <!-- Orbiting hearts around center -->
    <div class="orbit-container">
      <div class="orbit-heart">💕</div>
      <div class="orbit-heart">💖</div>
      <div class="orbit-heart">💗</div>
      <div class="orbit-heart">💝</div>
    </div>
    
    <!-- Falling hearts animation -->
    <div class="falling-hearts">
      <div class="falling-heart">💕</div>
      <div class="falling-heart">💖</div>
      <div class="falling-heart">💗</div>
      <div class="falling-heart">❤️</div>
      <div class="falling-heart">💝</div>
      <div class="falling-heart">💓</div>
      <div class="falling-heart">💕</div>
      <div class="falling-heart">💖</div>
    </div>
    
    <!-- Floating bubble hearts -->
    <div class="floating-bubbles">
      <div class="bubble-heart">💕</div>
      <div class="bubble-heart">💖</div>
      <div class="bubble-heart">💗</div>
      <div class="bubble-heart">❤️</div>
      <div class="bubble-heart">💝</div>
      <div class="bubble-heart">💓</div>
      <div class="bubble-heart">💕</div>
      <div class="bubble-heart">💖</div>
      <div class="bubble-heart">💗</div>
      <div class="bubble-heart">❤️</div>
    </div>
    
    <!-- Zigzag falling hearts -->
    <div class="zigzag-hearts">
      <div class="zigzag-heart">💝</div>
      <div class="zigzag-heart">💓</div>
      <div class="zigzag-heart">💕</div>
      <div class="zigzag-heart">💖</div>
      <div class="zigzag-heart">💗</div>
    </div>
    
    <!-- Spiral hearts -->
    <div class="spiral-hearts">
      <div class="spiral-heart">💖</div>
      <div class="spiral-heart">💕</div>
      <div class="spiral-heart">💗</div>
      <div class="spiral-heart">💝</div>
    </div>
    
    <!-- Exploding hearts from center -->
    <div class="exploding-hearts">
      <div class="explode-heart">💕</div>
      <div class="explode-heart">💖</div>
      <div class="explode-heart">💗</div>
      <div class="explode-heart">💝</div>
    </div>
    
    <%= yield %>
  </body>
</html>
